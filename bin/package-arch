#!/bin/sh
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
version=${1:-}
if [ -z "$version" ] || ! printf '%s' "$version" | grep -Eq '^[0-9]+(\.[0-9]+){2}([._a-zA-Z0-9]+)?$'; then
  printf '%s\n' 'Usage: bin/package-arch <version>, for example 0.1.0rc1' >&2
  exit 2
fi
if [ -n "$(git -C "$root" status --porcelain --untracked-files=normal)" ]; then
  printf '%s\n' 'Commit or remove all changes before building a release package.' >&2
  exit 1
fi
out="$root/dist/arch-$version"
if [ -e "$out" ]; then
  printf 'Output already exists: %s\nChoose a new version or move the old output.\n' "$out" >&2
  exit 1
fi
workdir=$(mktemp -d "${TMPDIR:-/tmp}/blueview-vpn-package.XXXXXXXX")
trap 'rm -rf -- "$workdir"' EXIT HUP INT TERM
archive="blue-view-sophos-vpn-client-$version.tar.gz"
git -C "$root" archive --format=tar --prefix="blue-view-sophos-vpn-client-$version/" -o "$workdir/source.tar" HEAD
gzip -n -c "$workdir/source.tar" > "$workdir/$archive"
sha=$(sha256sum "$workdir/$archive" | cut -d ' ' -f 1)
sed -e "s/@VERSION@/$version/g" -e "s/@SOURCE_SHA256@/$sha/g" "$root/packaging/PKGBUILD.in" > "$workdir/PKGBUILD"
mkdir -p "$workdir/packages"
cd "$workdir"
PACKAGER='The Blue View Group Corporation <devops@blueview.ai>' PKGDEST="$workdir/packages" makepkg --cleanbuild
mkdir -p "$out"
cp "$workdir/$archive" "$workdir/PKGBUILD" "$workdir/packages/"*.pkg.tar.zst "$out/"
cd "$out"
sha256sum ./*.pkg.tar.zst "$archive" PKGBUILD > SHA256SUMS
printf 'Built in %s\n' "$out"
